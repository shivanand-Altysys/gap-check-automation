{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    "lib": ["ES2020"],

    "rootDir": "./src",
    "outDir": "./build",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "sourceMap": true,

    "declaration": true,
    "declarationMap": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node", "@playwright/test"]
  },

  "include": [
    "src/**/*"
  ],

  "exclude": [
    "node_modules",
    "build",
    "reports",
    "dist"
  ]
}